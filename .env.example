# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RAZORPAY_KEY_ID: Razorpay Key ID for processing live payments in India.
VITE_RAZORPAY_KEY_ID="rzp_live_TefblkmIMTFIRH"
RAZORPAY_KEY_ID="rzp_live_TefblkmIMTFIRH"

# WHATSAPP_API_KEY: Meta WhatsApp Cloud API access token or WhatsApp Business API key.
# Kept strictly server-side for automated dispatch of weekly exam packets, mock test alerts, and order confirmations.
WHATSAPP_API_KEY=

# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Cloud API Phone Number ID.
WHATSAPP_PHONE_NUMBER_ID=

# CUSTOM_DOMAIN: The primary custom domain mapped to this Cloud Run deployment.
CUSTOM_DOMAIN="www.nextclasses.in"

# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS: Optional outbound mail configuration.
# If configured with a Gmail App Password or SMTP provider, emails will be delivered directly to student inboxes.
# If not set, the app provides 1-click Gmail web compose & mailto dispatches.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

